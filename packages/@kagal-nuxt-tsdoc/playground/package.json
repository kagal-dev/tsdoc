{
  "name": "@kagal/nuxt-tsdoc-playground",
  "private": true,
  "type": "module",
  "description": "Development playground for @kagal/nuxt-tsdoc",
  "scripts": {
    "build": "nuxt build",
    "clean": "rimraf .nuxt .output node_modules",
    "dev": "nuxt cleanup && nuxt dev",
    "generate": "nuxt generate",
    "lint": "eslint --fix .",
    "lint:check": "eslint .",
    "prepare": "nuxt prepare",
    "type-check": "nuxt typecheck"
  },
  "dependencies": {
    "@kagal/build-tsdoc": "workspace:^",
    "@kagal/nuxt-tsdoc": "workspace:^",
    "nuxt": "^4.4.2"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@poupe/eslint-config": "^0.10.0",
    "eslint": "^10.4.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": ">= 20.20.1",
    "pnpm": ">= 10.33.4"
  }
}
